POSTGRES_DB=metaslevo
POSTGRES_USER=metaslevo
POSTGRES_PASSWORD=change-me
WEB_HOST_PORT=8001
FRONTEND_HOST_PORT=8085

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# "backend" é necessário: o proxy do Vite (frontend) reescreve o Host para o alvo interno.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8085

DATABASE_URL=postgres://metaslevo:change-me@db:5432/metaslevo

# Postgres externo do histórico de vendas — somente leitura (ver docs/architecture.md,
# Anticorruption Layer). Deixe em branco enquanto não configurado; nada tenta conectar sem isso.
SALES_HISTORY_DATABASE_URL=

# E-mail (link de "definir senha" / "esqueci a senha"). Sem isso configurado, o e-mail só aparece
# no log do backend (`docker compose logs backend`) — nada é enviado de verdade.
# Para SMTP real, troque DJANGO_EMAIL_BACKEND para django.core.mail.backends.smtp.EmailBackend e
# preencha as variáveis EMAIL_*.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=naoresponda@levo.local

# URL do frontend, usada para montar o link enviado por e-mail.
FRONTEND_URL=http://localhost:8085

# --- Produção (docker-compose.prod.yml) ---
PROD_HTTP_PORT=8080
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Em produção (atrás do túnel Cloudflare), configure também:
#   DJANGO_DEBUG=False
#   DJANGO_ALLOWED_HOSTS=<hostname real do túnel>
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://<hostname real do túnel>
#   DJANGO_SECRET_KEY=<gerado, nunca o placeholder>
#   POSTGRES_PASSWORD=<senha real>
